    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\n\n// 1. טיפול במקרה של דילוג\nif (input.status === 'SKIPPED') {\n  return {\n    json: {\n      ...input,\n      currentState: 'CRM_SKIPPED',\n      response: JSON.stringify({ authorizationRequired: false, status: 'SKIPPED' })\n    }\n  };\n}\n\n// 2. חילוץ הטקסט הגולמי שהחזיר Ollama\nlet rawText = input.output || input.response || input;\nif (typeof rawText === 'object') {\n  rawText = JSON.stringify(rawText);\n}\n\nlet agentData = {};\n\n// 3. חילוץ חכם של JSON באמצעות REGEX\ntry {\n  const jsonMatch = rawText.match(/\\{[\\s\\S]*\\}/);\n  if (jsonMatch) {\n    agentData = JSON.parse(jsonMatch[0]);\n  } else {\n    agentData = JSON.parse(rawText);\n  }\n} catch (e) {\n  agentData = {\n    status: \"SUCCESS\",\n    summary: \"Parsed from unstructured Ollama output\"\n  };\n}\n\n// 4. חילוץ נתונים מנודים קודמים\nlet triggerData = {};\ntry {\n  triggerData = $('When Executed by Another Workflow').first().json || {};\n} catch (e) {\n  triggerData = {};\n}\n\nconst orderType = agentData.orderType || triggerData.orderType || input.orderType || 'RFQ';\n\n// 5. לוגיקה דטרמיניסטית לבדיקת HITL\nlet orderAccepted = null;\nif (agentData.orderAccepted !== undefined && agentData.orderAccepted !== null) {\n  orderAccepted = Boolean(agentData.orderAccepted);\n} else if (orderType === 'PO') {\n  orderAccepted = agentData.status === 'SUCCESS';\n}\n\nconst quoteAmount = Number(agentData.quoteAmountILS || agentData.totalPriceILS || 0);\nconst availableCredit = Number(agentData.availableCredit !== undefined ? agentData.availableCredit : 100000);\n\n// בדיקה מתמטית ודטרמיניסטית של התנאים\nconst isCreditExceeded = (orderType === 'PO') && (quoteAmount > availableCredit);\nconst isPriceMismatch = (orderType === 'PO') && (orderAccepted === false);\n\n// אישור HITL נדרש אך ורק אם יש חריגה מתמטית באשראי, אי-התאמת מחיר, או דרישה מפורשת מהסוכן\nconst requiresApproval = (orderType === 'PO') && (\n  agentData.authorizationRequired === true ||\n  isCreditExceeded ||\n  isPriceMismatch\n);\n\nconst finalOrderAccepted = requiresApproval ? false : orderAccepted;\n\nconst finalData = {\n  sessionId: agentData.sessionId || triggerData.sessionId || input.sessionId || '',\n  status: requiresApproval ? 'REJECTED' : 'SUCCESS',\n  quoteId: agentData.quoteId || triggerData.quoteId || '',\n  customerId: agentData.customerId || triggerData.customerId || '',\n  customerName: agentData.customerName || triggerData.customerName || '',\n  partNumber: agentData.partNumber || triggerData.partNumber || '',\n  quantity: agentData.quantity || triggerData.quantity || 0,\n  orderType: orderType,\n  creditStatus: agentData.creditStatus || 'OK',\n  availableCredit: availableCredit,\n  quoteAmountILS: quoteAmount,\n  orderAccepted: finalOrderAccepted,\n  authorizationRequired: requiresApproval,\n  nextAction: requiresApproval ? 'ADMIN_REVIEW' : 'PROCUREMENT',\n  summary: agentData.summary || ''\n};\n\nreturn {\n  json: {\n    ...finalData,\n    currentState: requiresApproval ? 'PENDING_APPROVAL' : 'CRM_PROCESSED',\n    validatedAt: new Date().toISOString(),\n    response: JSON.stringify(finalData)\n  }\n};"
      },
