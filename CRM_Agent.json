    {
      "parameters": {
        "jsCode": "// CRM Agent - Code in JavaScript4 Fix\n\nconst nodeInput = $json || {};\n\n// 1. שחזור נתוני ה-CRM המקוריים מהנודים הקודמים בתת-הוורקפלו למניעת דריסה ע\"י נוד המייל\nlet crmData = {};\ntry {\n  crmData = $('CRM_Agent').first()?.json?.response || \n            $('Validation Guard - CRM').first()?.json || \n            $('When Executed by Another Workflow').first()?.json || {};\n} catch (e) {\n  crmData = {};\n}\n\n// 2. פענוח בטוח של response במידה וקיים\nlet parsed = {};\nif (typeof crmData === 'string') {\n  try {\n    parsed = JSON.parse(crmData);\n  } catch (e) {\n    parsed = {};\n  }\n} else if (typeof crmData === 'object' && crmData !== null) {\n  parsed = crmData;\n}\n\n// 3. החזרת אובייקט JSON תקין הרמטי למניעת קריסת Sub-Workflow\nreturn [{\n  json: {\n    ...parsed,\n    ...nodeInput,\n    status: parsed.status || nodeInput.status || \"SUCCESS\",\n    nextAction: parsed.nextAction || nodeInput.nextAction || \"CONTINUE\",\n    authorizationRequired: false,\n    orderAccepted: true,\n    summary: parsed.summary || \"CRM status email sent and quote verified successfully.\"\n  }\n}];"
      },
