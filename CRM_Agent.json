        "jsCode": "// קוד עבור Code in JavaScript1 (הנוד שאחרי If1, לפני ה-HITL)\nlet res = {};\ntry {\n  res = typeof $json.response === 'string' ? JSON.parse($json.response) : ($json.response || $json);\n} catch (e) {\n  res = $json;\n}\n\nconst triggerData = $('When Executed by Another Workflow').first().json;\n\nreturn {\n  sessionId: res.sessionId || triggerData.sessionId || '',\n  quoteId: res.quoteId || triggerData.quoteId || '',\n  customerId: res.customerId || triggerData.customerId || '',\n  customerName: res.customerName || triggerData.customerName || '',\n  partNumber: res.partNumber || triggerData.partNumber || '',\n  quantity: res.quantity || triggerData.quantity || 0,\n  orderType: res.orderType || triggerData.orderType || 'PO',\n  quoteAmountILS: res.quoteAmountILS || triggerData.totalPriceList || 0,\n  reason: res.summary || 'Requires manual approval due to PO review / credit limits'\n};"
