    {
      "parameters": {
        "jsCode": "const errorData = $input.item.json;\n\n// חילוץ פרטי הריצה והשגיאה שנלכדו\nconst executionId = errorData.execution?.id || \"N/A\";\nconst workflowName = errorData.workflow?.name || \"Unknown Workflow\";\nconst workflowId = errorData.workflow?.id || \"N/A\";\nconst failedNodeName = errorData.node?.name || \"Unknown Node\";\nconst errorMessage = errorData.error?.message || \"No error message provided\";\n\n// ניסיון חילוץ Session ID מנתוני הריצה שכשלה\nlet sessionId = \"UNKNOWN_SESSION\";\ntry {\n  if (errorData.execution?.data?.resultData?.runData) {\n    const runData = errorData.execution.data.resultData.runData;\n    const firstNodeKey = Object.keys(runData)[0];\n    if (firstNodeKey && runData[firstNodeKey][0]?.data?.main[0][0]?.json) {\n      const rootJson = runData[firstNodeKey][0].data.main[0][0].json;\n      sessionId = rootJson.sessionId || rootJson.data?.sessionId || sessionId;\n    }\n  }\n} catch (e) {\n  console.log(\"Could not extract sessionId from error payload\");\n}\n\nreturn [{\n  json: {\n    sessionId: sessionId,\n    executionId: executionId,\n    workflowName: workflowName,\n    workflowId: workflowId,\n    failedNodeName: failedNodeName,\n    errorMessage: errorMessage,\n    timestamp: new Date().toISOString()\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        0
      ],
